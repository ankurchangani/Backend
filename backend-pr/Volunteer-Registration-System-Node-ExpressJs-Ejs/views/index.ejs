<!DOCTYPE html>
<html>

<head>
    <title>Register New Volunteers</title>
</head>

<body style="background-color: #121212; color: #e0e0e0; height: 100vh; margin: 0; padding: 20px;">

    <h1 style="text-align: center;">Register Form</h1>
    
    <div style="display: flex; justify-content: center; align-items: flex-start; gap: 20px; flex-wrap: wrap;">
        <form action="/add" method="post"
            style="flex: 1 1 45%; background: #1e1e1e; padding: 20px; border-radius: 10px; box-shadow: 0px 0px 15px 2px #000; min-width: 300px;">
            <h2 style="text-align: center; color: #ffffff;">  Registration Form</h2>

            <label style="font-weight: bold;">Name:</label>
            <input type="text" name="name"
                style="background-color: #2a2a2a; color: #e0e0e0; width: 100%; padding: 8px; margin: 6px 0; border: 1px solid #444; border-radius: 5px;">

            <label style="font-weight: bold;">Email:</label>
            <input type="email" name="email"
                style="background-color: #2a2a2a; color: #e0e0e0; width: 100%; padding: 8px; margin: 6px 0; border: 1px solid #444; border-radius: 5px;">

            <label style="font-weight: bold;">Phone Number:</label>
            <input type="tel" name="phone"
                style="background-color: #2a2a2a; color: #e0e0e0; width: 100%; padding: 8px; margin: 6px 0; border: 1px solid #444; border-radius: 5px;">

            <label style="font-weight: bold;">Skills:</label>
            <input type="text" name="skills"
                style="background-color: #2a2a2a; color: #e0e0e0; width: 100%; padding: 8px; margin: 6px 0; border: 1px solid #444; border-radius: 5px;">

            <button type="submit"
                style="width: 100%; padding: 10px; background-color: #2e7d32; color: white; border: none; border-radius: 5px; font-size: 16px; cursor: pointer; margin-top: 6px;">Register</button>
        </form>

        <br>
        <!-- Volunteer List ViewData -->
        <div
            style="flex: 1 1 45%; background: #1e1e1e; padding: 20px; border-radius: 10px; box-shadow: 0px 0px 15px 2px #000; min-width: 300px;">
            <h2 style="text-align: center; color: #ffffff;">Volunteer List</h2>
            <table style="width: 100%; margin-top: 10px; color: #e0e0e0;" cellpadding="0" cellspacing="0">
                <thead>
                    <tr>
                        <th style="padding: 10px; border: 1px solid #333;">Name</th>
                        <th style="padding: 10px; border: 1px solid #333;">Email</th>
                        <th style="padding: 10px; border: 1px solid #333;">Phone</th>
                        <th style="padding: 10px; border: 1px solid #333;">Skills</th>
                        <th style="padding: 10px; border: 1px solid #333;">Action</th>
                    </tr>
                </thead>
                <tbody>
                    <% localData.forEach((item) => { %>
                    <tr>
                        <td style="padding: 10px; border: 1px solid #333;"><%= item.name %></td>
                        <td style="padding: 10px; border: 1px solid #333;"><%= item.email %></td>
                        <td style="padding: 10px; border: 1px solid #333;"><%= item.phone %></td>
                        <td style="padding: 10px; border: 1px solid #333;"><%= item.skills %></td>
                        <td style="padding: 10px; border: 1px solid #333;">
                            <a href="/update/<%= item.id %>" style="margin-right: 5px; background: #2e7d32; padding: 5px 8px; color: #fff; text-decoration: none; border-radius: 4px;">Edit</a>
                            <a href="/delete/<%= item.id %>" style="background: #b71c1c; padding: 5px 8px; color: #fff; text-decoration: none; border-radius: 4px;">Delete</a>
                        </td>
                    </tr>
                    <% }); %>
                </tbody>
            </table>
        </div>
    </div>

</body>
</html>