<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <title><%= fileName %></title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-zinc-900 min-h-screen text-white px-6 py-10">
    <a href="/" class="text-blue-400 hover:underline mb-6 inline-block">Go back home</a>
    <div class="max-w-xl mx-auto bg-zinc-800 p-6 rounded-xl shadow-lg mb-10">
      <form action="/edit" method="post">
        <h2 class="text-2xl text-white font-semibold mb-4">Update Task</h2>
        <input
          type="text"
          placeholder="previous title goes here"
          name="previous"
          value="<%= fileName.replace('.txt', '') %>"
          class="bg-zinc-700 w-full p-3 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
        />
        <input
          type="text"
          placeholder="new title goes here"
          name="new"
          class="bg-zinc-700 w-full p-3 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
        />
        <input
          type="submit"
          value="Update Task"
          class="bg-yellow-600 w-full p-3 text-white font-medium rounded-lg hover:bg-blue-700 transition"
        />
      </form>
    </div>
  </body>
</html>
