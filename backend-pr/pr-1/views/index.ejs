<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Task Manager</title>
    <script src="https://cdn.tailwindcss.com"></script>
  </head>
  <body class="bg-zinc-900 min-h-screen">
    <div class="container mx-auto py-10 px-4">
      <div class="max-w-xl mx-auto bg-zinc-800 p-6 rounded-xl shadow-lg mb-10">
        <form action="/create" method="post">
          <h2 class="text-2xl text-white font-semibold mb-4">Add New Task</h2>

          <input
            type="text"
            placeholder="Title goes here"
            name="title"
            class="bg-zinc-700 w-full p-3 text-white rounded-lg focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
          />

          <textarea
            placeholder="Write your task"
            name="details"
            class="bg-zinc-700 w-full p-3 text-white rounded-lg h-32 resize-none focus:outline-none focus:ring-2 focus:ring-blue-500 mb-4"
          ></textarea>

          <input
            type="submit"
            value="Create Task"
            class="bg-blue-600 w-full p-3 text-white font-medium rounded-lg hover:bg-blue-700 transition"
          />
        </form>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6">
        <% if (files.length > 0) { %> <% files.forEach((val) => { %>
        <div class="bg-zinc-800 p-5 rounded-lg">
          <h1 class="text-xl text-white font-semibold mb-2"><%= val %></h1>
          <div class="flex w-full justify-between items-center">
            <a href="/file/<%= val %>" class="text-blue-400 hover:underline"
              >Read more</a
            >

            <a href="/edit/<%= val %>" class="text-blue-400 hover:underline"
              >Edit Flie name</a
            >

            <a href="/delete/<%= val %>" class="text-red-400 hover:underline">  Delete</a>
          </div>
        </div>
        <% }) %> <% } else { %>
        <div class="mt-10 text-center col-span-full">
          <h3 class="text-xl text-white font-semibold tracking-wider">
            No task found
          </h3>
        </div>
        <% } %>
      </div>
    </div>
  </body>
</html>
