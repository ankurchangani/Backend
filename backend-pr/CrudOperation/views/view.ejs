<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>User List</title>
  <script src="https://cdn.tailwindcss.com"></script>
</head>
<body class="bg-gray-100 text-gray-800">

  <div class="max-w-4xl mx-auto py-10">
    <h1 class="text-3xl font-bold mb-6 text-center">All Users</h1>

    <div class="bg-white p-6 rounded shadow">
      <table class="w-full text-left table-auto border-collapse">
        <thead>
          <tr class="bg-gray-200">
            <th class="p-2 border">Name</th>
            <th class="p-2 border">Email</th>
            <th class="p-2 border">Password</th>
            <th class="p-2 border text-center">Actions</th>
          </tr>
        </thead>
        <tbody>
          <% if (users.length === 0) { %>
            <tr>
              <td colspan="4" class="p-4 text-center text-gray-500">No users found.</td>
            </tr>
          <% } else { %>
            <% users.forEach(user => { %>
              <tr class="hover:bg-gray-50">
                <td class="p-2 border"><%= user.name %></td>
                <td class="p-2 border"><%= user.email %></td>
                <td class="p-2 border"><%= user.password %></td>
                <td class="p-2 border text-center">
                  <a href="/edit/<%= user._id %>" class="text-blue-600 hover:underline">Edit</a> |
                  <a href="/delete/<%= user._id %>" class="text-red-600 hover:underline" onclick="return confirm('Are you sure you want to delete this user?')">Delete</a>
                </td>
              </tr>
            <% }) %>
          <% } %>
        </tbody>
      </table>
    </div>

    <div class="text-center mt-4">
      <a href="/" class="text-blue-600 hover:underline">← Add New User</a>
    </div>
  </div>

</body>
</html>
